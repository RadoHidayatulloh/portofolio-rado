---
// "use-client";

import "../styles/global.css";
import Header from "./Header.astro";
---

<!-- Ganti text-poopins menjadi font-sans -->
<section class="font-sans w-full min-h-screen bg-black">
  <div style="position: sticky; top: 20px">
    <Header />
  </div>

  <div style="width: 92%; margin: 100px auto auto auto; w-full h-full">
    <!-- Sapaan -->
    <div>
      <!-- Warna text-green-700 dijamin langsung menyala hijau pekat sekarang! -->
      <h2
        class="text-green-700 font-bold"
        style="color: green; font-size: 17px; font-weight: bolder;"
      >
        HELLO, I'M
      </h2>

      <h1 class="text-white text-3xl mt-2 font-bold" style="font-size: 40px;">
        Rado Hidayatulloh
      </h1>
    </div>

    <div>
      <h5 style="color: rgb(175, 175, 175); font-weight: bolder;">
        Cyber Security Engineer <br /> & <span style="color: green;"
          >Go Developer</span
        >
      </h5>

      <div class="subTitle" style="margin-top: 30px;">
        <p style="color:  rgb(175, 175, 175)">
          I Build secure systems, analyze, vulnerabilities, and develop tools
          that solve real-word problems.
        </p>
      </div>
    </div>

    <div style=" justify-content: center; margin-top: 30px">
      <div style="width: 100%;">
        <button
          style="display: flex; justify-content: center; align-items: center; background: linear-gradient(to left, green, rgb(17, 17, 58), rgb(130, 87, 8)); width: 100%; padding: 10px; border-radius: 10px;"
        >
          <span style=" color: white; font-weight: bold;">View My Project</span>
        </button>
      </div>

      <div style="width: 100%; margin-top: 10px;">
        <button
          style="background:linear-gradient(to right, rgb(2, 2, 35), rgb(47, 46, 46)); width: 100%; padding: 10px; border-radius: 10px;"
        >
          <span style="color: white; font-weight: bold;">Download My CV</span>
        </button>
      </div>

      <div
        class=""
        style="display: flex; justify-content: center; margin-top: 30px; gap: 30px"
      >
        <i class="bi bi-github" style="color: white; font-size: 25px;"></i>
        <i class="bi bi-linkedin" style="color: white; font-size: 25px;"></i>
        <i class="bi bi-envelope-fill" style="color: white; font-size: 25px;"
        ></i>
      </div>
    </div>

    <div style="margin-top: 30px; w-full h-full bg-black">
      <div class="border-3 border-white-300 rounded-md p-2">
        <p class="font-bold" style="color: rgb(19, 161, 19); font-size: 13px;">
          rado@portofolio:~$ whoami
        </p>

        <div
          class="border-3 flex flex-col gap-2 border-white-300 rounded-md p-2"
        >
          <div class="flex gap-3 text-white text-[13px]">
            <span>Name :</span>
            <span>Rado Hidayatulloh</span>
          </div>
          <div class="flex gap-3 text-white text-[13px]">
            <span>Role :</span>
            <span>Cyber Security Engineer</span>
          </div>
          <div class="flex gap-3 text-white text-[13px]">
            <span>Focus :</span>
            <span>Security & Backend</span>
          </div>
          <div class="flex gap-3 text-white text-[13px]">
            <span>From :</span>
            <span>Lampung, Indonesia</span>
          </div>
          <div class="flex gap-3 text-white text-[13px]">
            <span>Status :</span>
            <span class="text-green-400">Available for Internship</span>
          </div>
        </div>

        <div class="flex gap-1 items-center">
          <p
            class="font-bold mt-3"
            style="color: rgb(19, 161, 19); font-size: 13px; "
          >
            rado@portofolio:~$
          </p>
          <div class="w-1 h-4 bg-green-600"></div>
        </div>
      </div>
    </div>

    <!-- About Me -->
    <div class="mt-5">
      <div>
        <h3 class="text-white font-bold">About Me</h3>
        <div class="flex gap-2 flex-col">
          <div
            class="h-1 w-17 rounded-md"
            style="background-color: rgb(8, 142, 8);"
          >
          </div>
          <div
            class="h-0.5 w-10 rounded-md"
            style="background: linear-gradient(to left, rgba(255, 255, 255, 0.535), green);"
          >
          </div>
        </div>

        <div class="mt-4">
          <p class="font-bold" style="color: rgb(131, 130, 130);">
            I'm an informatics student with a strong interestt in Cyber Security
            and Backend Development. <br />
            <br /> I enjoy building secure and efficient systems, analyzing security
            issues, and automating tasks. <br />
            <br /> I'm constantly improving my skills and exploring new technologies.
          </p>
        </div>
      </div>
    </div>

    <!-- WHAT I DO -->
    <div class="mt-5">
      <div>
        <h3 class="text-white font-bold" style="font-weight: bold;">
          WHAT I DO
        </h3>

        <div class="flex gap-2 flex-col">
          <div
            class="h-1 w-17 rounded-md"
            style="background-color: rgb(8, 142, 8);"
          >
          </div>
          <div
            class="h-0.5 w-10 rounded-md"
            style="background: linear-gradient(to left, rgba(255, 255, 255, 0.535), green);"
          >
          </div>
        </div>

        <div class="flex flex-col gap-4 mt-5">
          <div class="flex items-center gap-3">
            <div>
              <i class="bi bi-shield-slash text-green-400 text-4xl"></i>
            </div>
            <div class="text-white font-bold">
              <h5>Security</h5>
              <span class="text-md" style="color:  rgba(255, 255, 255, 0.535) ;"
                >Web Security, Network Security, vulnerability Security</span
              >
            </div>
          </div>

          <div class="flex items-center gap-3">
            <div>
              <i class="bi bi-code-slash text-green-400 text-4xl"></i>
            </div>
            <div class="text-white font-bold">
              <h5>Development</h5>
              <span class="text-md" style="color:  rgba(255, 255, 255, 0.535) ;"
                >Backend Development with Go and Express.js, RESTful API, and
                Database
              </span>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <div>
              <i class="bi bi-hdd-rack-fill text-green-400 text-4xl"></i>
            </div>
            <div class="text-white font-bold">
              <h5>Infrastructur</h5>
              <span class="text-md" style="color:  rgba(255, 255, 255, 0.535) ;"
                >Linux, Docker, Networking, CI/CD, and DevOps.</span
              >
            </div>
          </div>

          <div class="flex items-center gap-3">
            <div>
              <i class="bi bi-book text-green-400 text-4xl"></i>
            </div>
            <div class="text-white font-bold">
              <h5>Infrastructur</h5>
              <span class="text-md" style="color:  rgba(255, 255, 255, 0.535) ;"
                >Always, Leaning new things and sharing knowledge</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Skills -->

    <div class="mt-15">
      <div>
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-white">SKILLS</h3>

            <div class="flex gap-2 flex-col">
              <div
                class="h-1 w-17 rounded-md"
                style="background-color: rgb(8, 142, 8);"
              >
              </div>
              <div
                class="h-0.5 w-10 rounded-md"
                style="background: linear-gradient(to left, rgba(255, 255, 255, 0.535), green);"
              >
              </div>
            </div>
          </div>

          <div>
            <i class="bi bi-code-slash text-green-600 text-3xl"></i>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3 mt-5">
          <div class="flex flex-col text-center">
            <i class="bi bi-shield-fill text-3xl text-green-400"></i>
            <p class="text-white">Cyber Security</p>
          </div>

          <div class="flex flex-col grids text-center">
            <i class="bi bi-braces text-3xl text-green-400"></i>
            <p class="text-white">Software Developer</p>
          </div>

          <div class="flex flex-col grids text-center">
            <i class="bi bi-tux text-3xl text-green-400"></i>
            <p class="text-white">Linux</p>
          </div>

          <div class="flex flex-col grids text-center">
            <i class="bi bi-router text-3xl text-green-400"></i>
            <p class="text-white">Networking</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Technologies -->

    <div class="mt-15">
      <div>
        <div>
          <h3 class="text-white">Technology Use</h3>

          <div class="flex gap-2 flex-col">
            <div
              class="h-1 w-17 rounded-md"
              style="background-color: rgb(8, 142, 8);"
            >
            </div>
            <div
              class="h-0.5 w-10 rounded-md"
              style="background: linear-gradient(to left, rgba(255, 255, 255, 0.535), green);"
            >
            </div>
          </div>
        </div>
        <div class="mt-5 grid grid-cols-2">
          <div class="text-center">
            <i class="bi bi-tux text-white text-3xl"></i>
            <p class="text-white">Ubuntu & kali linux</p>
          </div>

          <div class="text-center">
            <i class="bi bi-code text-white text-3xl"></i>
            <p class="text-white">Golang & ExpressJs</p>
          </div>

          <div class="text-center">
            <i class="bi bi-router text-white text-3xl"></i>
            <p class="text-white">Mikrotik</p>
          </div>

          <div class="text-center">
            <i class="bi bi-window-sidebar text-white text-3xl"></i>
            <p class="text-white">Figma</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Project -->

    <div class="mt-15">
      <div>
        <div>
          <h3 class="text-white">Features Project</h3>

          <div class="flex gap-2 flex-col">
            <div
              class="h-1 w-17 rounded-md"
              style="background-color: rgb(8, 142, 8);"
            >
            </div>
            <div
              class="h-0.5 w-10 rounded-md"
              style="background: linear-gradient(to left, rgba(255, 255, 255, 0.535), green);"
            >
            </div>
          </div>
        </div>
        <div class="mt-25">
          <div>
            <h3 class="text-center text-white font-bold">Comming Soon</h3>
          </div>
        </div>
      </div>
    </div>

    <!-- Labs and Write Ups -->
    <div class="mt-15">
      <div>
        <div>
          <h3 class="text-white">Labs Pojects</h3>

          <div class="flex gap-2 flex-col">
            <div
              class="h-1 w-17 rounded-md"
              style="background-color: rgb(8, 142, 8);"
            >
            </div>
            <div
              class="h-0.5 w-10 rounded-md"
              style="background: linear-gradient(to left, rgba(255, 255, 255, 0.535), green);"
            >
            </div>
          </div>
        </div>
        <div class="mt-10">
          <div class="grid grid-cols-2 justify-center text-center gap-3">
            <div
              class="w-40 h-40 border-3 rounded-xl border-['rgba(255, 255, 255, 0.535)'] flex justify-center align-items-center"
              style="background-color: #222222;"
            >
              <div class="text-center flex flex-col gap-2">
                <i class="bi bi-braces-asterisk text-green-400 text-3xl"></i>
                <p class="text-white">XSS</p>
              </div>
            </div>

            <div
              class="w-40 h-40 border-3 rounded-xl border-['rgba(255, 255, 255, 0.535)'] flex justify-center align-items-center"
              style="background-color: #222222;"
            >
              <div class="text-center flex flex-col gap-2">
                <i class="bi bi-database text-green-400 text-3xl"></i>
                <p class="text-white">SQL Injection</p>
              </div>
            </div>

            <div
              class="w-40 h-40 border-3 rounded-xl border-['rgba(255, 255, 255, 0.535)'] flex justify-center align-items-center"
              style="background-color: #222222;"
            >
              <div class="text-center flex flex-col gap-2">
                <i class="bi bi-shield-fill text-green-400 text-3xl"></i>
                <p class="text-white">CSRF</p>
              </div>
            </div>

            <div
              class="w-40 h-40 border-3 rounded-xl border-['rgba(255, 255, 255, 0.535)'] flex justify-center align-items-center"
              style="background-color: #222222;"
            >
              <div class="text-center flex flex-col gap-2">
                <i class="bi bi-cloud-arrow-up-fill text-green-400 text-3xl"
                ></i>
                <p class="text-white">SSRF</p>
              </div>
            </div>
          </div>

          <div class="mt-4 text-center">
            <a class="text-white text-decoration-none" href="/content"
              >View All Write-Ups or Labs ......</a
            >
          </div>
        </div>
      </div>
    </div>

    <!-- Sertificate -->

    <div class="pb-50 mt-15">
      <div>
        <div>
          <h3 class="text-white">Sertificate</h3>

          <div class="flex gap-2 flex-col">
            <div
              class="h-1 w-17 rounded-md"
              style="background-color: rgb(8, 142, 8);"
            >
            </div>
            <!-- <div
              class="h-0.5 w-10 rounded-md"
              style="background: linear-gradient(to left, rgba(255, 255, 255, 0.535), green);"
            > -->
          </div>
        </div>
      </div>
      <div class="mt-5 flex flex-col gap-3">
        <div>
          <div
            class="w-['90%'] h-auto border-3 border-['rgba(255, 255, 255, 0.535)'] rounded-xl"
          >
            <div class="w-['90%']">
              <div
                class="flex justify-center h-40 items-center text-center hover:p-3"
              >
                <img
                  src=""
                  alt="Priview Certificate"
                  class="text-white font-bold flex"
                />
              </div>

              <div style="width: 90%; margin: auto">
                <h6 class="text-white">AWS Academy - Infrastructur</h6>

                <div>
                  <p class="text-white text-xs">
                    Sertificate AWS - Infrastructur yang dimana ini mempelajari
                    bagaimana sebuah Infrastructur dibangun
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div>
          <div
            class="w-['90%'] h-auto border-3 border-['rgba(255, 255, 255, 0.535)'] rounded-xl"
          >
            <div class="w-['90%']">
              <div
                class="flex justify-center h-40 items-center text-center hover:p-3"
              >
                <img
                  src=""
                  alt="Priview Certificate"
                  class="text-white font-bold flex"
                />
              </div>

              <div style="width: 90%; margin: auto">
                <h6 class="text-white">AWS Academy - Infrastructur</h6>

                <div>
                  <p class="text-white text-xs">
                    Sertificate AWS - Infrastructur yang dimana ini mempelajari
                    bagaimana sebuah Infrastructur dibangun
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
